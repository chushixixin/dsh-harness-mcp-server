{
  "name": "@chushixixin/dsh-harness-mcp-server",
  "version": "0.1.13",
  "description": "Expose DeepSeek Harness agent capabilities as an MCP server, so an external MCP client (e.g. Hermes) can drive Harness to execute coding tasks. Hermes = brain, Harness = arms.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib",
    "src",
    "cordis.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b && tsdown --env.DSH_BUILD_FACE host"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "cordis",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chushixixin/dsh-harness-mcp-server.git"
  },
  "homepage": "https://github.com/chushixixin/dsh-harness-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/chushixixin/dsh-harness-mcp-server/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    }
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.3.0-0 <0.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.3.0-0 <0.4.0",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.3.0-0 <0.4.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.3.0-0 <0.4.0",
    "@deepseek-ai/dsh-scope": ">=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.3.0-0 <0.4.0",
    "@deepseek-ai/dsh-session": ">=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.3.0-0 <0.4.0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.3.0-0 <0.4.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.1",
    "@deepseek-ai/dsh-scope": "0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1"
  }
}
